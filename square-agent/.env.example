# SquareAgent 环境变量配置
# 复制为 .env 并填写实际值

# 智谱 GLM API
GLM_API_KEY=

# News Pipeline LLM 模型（可选，默认 glm-4-flash-250414 永久免费）
# NEWS_ZHIPU_MODEL=glm-4-flash-250414
# News Pipeline LLM 端点（可选，默认编码套餐）
# NEWS_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# 币安广场 API
BINANCE_SQUARE_OPENAPI_KEY=

# Telegram Bot (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Bot API Key (server ↔ bot 通信)
BOT_API_KEY=binsquare-dev-key-2026

# 代理 (可选，如果需要翻墙访问 RSS)
# RSS_PROXY=http://host.docker.internal:7890

# ========== Data Directory Configuration ==========
# 所有运行时数据默认放在 ~/.square-agent/，以下变量提供覆盖能力。
# 完整路径表见 src/paths.mjs。

# SQUARE_AGENT_DATA_DIR=~/.square-agent
# SQUARE_AGENT_LOG_DIR=~/.square-agent/logs
# SQUARE_AGENT_TMP_DIR=~/.square-agent/tmp
# SQUARE_AGENT_SERVER_DB=~/.square-agent/server/data.db
# SQUARE_AGENT_BOT_DB_DIR=~/.square-agent/bot
# DATABASE_PATH=~/.square-agent/bot/square-agent.db
# SQUARE_AGENT_NEWS_DATA_DIR=~/.square-agent/news-pipeline
# SQUARE_AGENT_REPO_DIR=~/clawd/square-agent
