# WiFi 网卡接口配置
# 使用 /usr/sbin/networksetup -listallhardwareports 查看接口名称

# WiFi 网卡接口（通常是 en1，请根据实际情况修改）
WIFI_IF=en1

# 国内 WiFi SSID（访问国内网站时使用）
WIFI_DOMESTIC_SSID=HUAWEI_DOMESTIC

# 国外 WiFi SSID（访问国外网站时使用，待填写）
WIFI_FOREIGN_SSID=HUAWEI-FOREIGN

# 默认网络偏好（false=优先国内，true=优先国外）
WIFI_PREFER_FOREIGN=false

# 对GFW域名优先使用代理（true=先尝试ClashX Pro代理，失败再切换WiFi）
USE_PROXY_FIRST=true

# 调试模式
# DEBUG=true
